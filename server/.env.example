# Server-only configuration. Copy this file to server/.env.local and use real local values there.
RESUMETRICS_AI_API_KEY=your_groq_api_key_here
# groq, or mock for canned offline answers (CI, tests, working without a key; never in production).
RESUMETRICS_AI_PROVIDER=groq
RESUMETRICS_AI_DEFAULT_MODEL=openai/gpt-oss-20b
# Optional per-task models (leave empty to use the default). Choose with `npm run ai:eval`.
RESUMETRICS_AI_MODEL_NIMBUS=
RESUMETRICS_AI_MODEL_JD=
RESUMETRICS_AI_MODEL_LINKEDIN=
RESUMETRICS_AI_MODEL_GITHUB=
# Rate limits (defaults shown). Provider limits match the Groq free tier; check your real limits at
# https://console.groq.com/settings/limits and raise them here after upgrading.
# RESUMETRICS_LIMIT_IP_PER_MINUTE=60
# RESUMETRICS_LIMIT_USER_AI_PER_MINUTE=10
# RESUMETRICS_LIMIT_USER_AI_PER_DAY=150
# RESUMETRICS_AI_RPM=30
# RESUMETRICS_AI_TPM=8000
# RESUMETRICS_AI_RPD=1000
# RESUMETRICS_AI_TPD=200000
# Per-user daily AI allowance in tokens (a NIMBUS turn is roughly 6-8k, a resume import 10-30k) and the time zone
# whose midnight resets it. Raise the allowance after moving off the free tier.
# RESUMETRICS_USER_DAILY_TOKENS=50000
# RESUMETRICS_USAGE_TIME_ZONE=Asia/Kolkata
# Number of reverse proxies in front of the server once deployed (e.g. 1 on Cloud Run or Render). 0 locally.
# RESUMETRICS_TRUST_PROXY=0
# How many of the most recently pushed repositories a GitHub evidence scan covers.
RESUMETRICS_GITHUB_SCAN_CAP=25

# Job tracker (Pro). JSearch key from https://www.openwebninja.com (JSearch API).
# Naukri, Indeed and Internshala: context.dev reads each board's listing page (key from https://www.context.dev/dashboard/api-keys,
# about 5 credits per board per fresh search); Tavily (https://tavily.com) searches the board instead when context.dev is unset or fails.
JSEARCH_API_KEY=
CONTEXT_DEV_API_KEY=
TAVILY_API_KEY=
# Fresh job searches per user per day (cached repeats are free) and how long a search is cached.
# RESUMETRICS_JOB_SEARCHES_PER_DAY=15
# RESUMETRICS_JOB_CACHE_HOURS=6
# Optional: only needed when the browser is served from a different origin.
RESUMETRICS_WEB_ORIGIN=http://localhost:5173

# GitHub App connection (server-only). Enable “Request user authorization (OAuth)
# during installation” and “Redirect on update” in the GitHub App settings. Its
# Redirect URI must match GITHUB_CALLBACK_URL exactly; the frontend forwards the
# one-time code to the backend so client secrets and tokens stay server-only.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=resumetrics-evidence
GITHUB_CALLBACK_URL=http://localhost:5173/workspace
FRONTEND_URL=http://localhost:5173

# Firebase Admin is required only by the Express backend to verify Firebase ID tokens
# and store GitHub connection metadata in Firestore. Point this to an uncommitted
# Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional standard Google credential-path alternative to the variable above.
GOOGLE_APPLICATION_CREDENTIALS=
