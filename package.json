{
  "name": "resumetrics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:all": "concurrently -n client,server -c cyan,magenta \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node -e \"const fs=require('fs');const cp=require('child_process');for(const f of fs.readdirSync('tests').filter((n)=>n.endsWith('.test.js')).sort()){const r=cp.spawnSync(process.execPath,['tests/'+f],{stdio:'inherit'});if(r.status!==0)process.exit(r.status??1);}\"",
    "ai:eval": "node server/ai/evals/run.mjs",
    "ai:ping": "node server/ai/ping.mjs",
    "fonts:fetch": "node scripts/fonts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.14",
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "groq-sdk": "^1.6.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "mammoth": "^1.12.2",
    "octokit": "^5.0.5",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "simple-icons": "^16.33.0",
    "tailwindcss": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "shell-quote": "^1.12.0",
    "uuid": "^11.1.1",
    "mammoth": {
      "argparse": "^2.0.1"
    }
  }
}
