# Dependencies, generated bundles, and local tool caches
node_modules/
dist/
.npm-cache/
**/.npm-cache/
.npm-cache*/
**/.npm-cache*/
.vite/
**/.vite/
.cache/
**/.cache/
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
*.tsbuildinfo

# Local logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Private environment configuration (including server/.env.local)
.env
.env.*
!.env.example
!**/.env.example

# Credentials and secret material
*.pem
.secrets/
secrets/
**/secrets/
*firebase-adminsdk*.json
*service-account*.json
firebase-service-account*.json
service-account/
**/service-account/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Locally generated reports and their render intermediates.
/output/
/tmp/
